/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/styles.css
  Cache-Control: public, max-age=3600

/app.js
  Cache-Control: public, max-age=3600

/tracking.js
  Cache-Control: public, max-age=3600

/marketplaces.js
  Cache-Control: public, max-age=3600

/apk/
  Cache-Control: no-store

/apk/index.html
  Cache-Control: no-store

/apk.html
  Cache-Control: no-store

/latest.apk
  Cache-Control: no-store
  Content-Disposition: attachment; filename="latest.apk"
  Content-Type: application/vnd.android.package-archive

/assets/style-images/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
