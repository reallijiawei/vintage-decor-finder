{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vintage-decor-finder",
  "main": "./src/worker.js",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS_DB",
      "database_name": "vintage_decor_finder_subscribers",
      "database_id": "2b067133-d987-4881-9f29-ef1fff09897f"
    }
  ],
  // EXPORT_TOKEN is configured in Cloudflare Variables and Secrets.
  // Do not commit the real token in this file.
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
